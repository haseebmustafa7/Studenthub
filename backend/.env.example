PORT=5000
NODE_ENV=development
# Optional for local demo mode. If these are blank/placeholder, the backend uses safe in-memory demo data.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
# Gemini is backend-only. Never put this key in frontend/.env or any VITE_* variable.
GEMINI_API_KEY=your_gemini_api_key
# Stable Gemini model. Keep this on the backend only.
GEMINI_MODEL=gemini-3.6-flash
# AI reliability controls
GEMINI_TIMEOUT_MS=30000
GEMINI_CACHE_TTL_MS=600000
GEMINI_CACHE_MAX_ENTRIES=200
GEMINI_AI_RATE_LIMIT=10
GEMINI_AI_RATE_WINDOW_MS=900000
CORS_ORIGIN=http://localhost:5173
